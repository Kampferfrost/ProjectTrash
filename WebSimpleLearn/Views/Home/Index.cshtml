@using EFCore
@model IEnumerable<User>

@{
    ViewData["Title"] = "Home Page";
    Layout = null;
}

<h4>Customers</h4>
<hr />
<table cellpadding="0" cellspacing="0">
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Level</th>
    </tr>
    @foreach (var customer in Model)
    {
        <tr>
            <td>@customer.Id</td>
            <td>@customer.Name</td>
            <td>@customer.Age</td>
        </tr>
    }
</table>
